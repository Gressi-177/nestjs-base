set -euo pipefail

# ===== Colors =====
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# ===== Lấy tên nhánh an toàn (trả về rỗng nếu detached HEAD) =====
BRANCH="$(git symbolic-ref --short -q HEAD || true)"

# ===== Whitelist (tùy chọn) =====
# Cho phép bỏ qua kiểm tra với một số nhánh cố định/pattern (nếu không cần thì để mảng rỗng)
ALLOW_BRANCHES='^(main|master|develop|dev|release\/.+)$'

# ===== Quy tắc tên nhánh của bạn =====
# ví dụ: feature.PROJ-123.add-login
REGEX='^(feature|bugfix|hotfix|release|merge)\.([a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)*)$'

echo "${BLUE}Branch name:${NC} ${GREEN}${BRANCH:-<detached>}${NC}"

# Nếu detached HEAD (ví dụ chạy trong CI hoặc checkout commit cụ thể), bỏ qua check tên nhánh
if [ -z "${BRANCH}" ]; then
  echo "${GREEN}Detached HEAD detected → skip branch name check.${NC}"
else
  # Cho phép whitelist
  if echo "$BRANCH" | grep -Eq "$ALLOW_BRANCHES"; then
    echo "${GREEN}Branch is whitelisted → skip branch name check.${NC}"
  else
    # Kiểm tra theo regex
    if ! echo "$BRANCH" | grep -Eq "$REGEX"; then
      echo "${RED}❌ Your commit was rejected due to an invalid branch name.${NC}"
      echo "Expected format: (feature|bugfix|hotfix|release|merge).<ticket?>.<subject>"
      echo "Example: feature.PROJ-123.add-auth"
      exit 1
    fi
  fi
fi

# ===== Lint-staged =====
echo "${BLUE}Running lint-staged...${NC}"
pnpm lint-staged
